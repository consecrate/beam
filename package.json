{
  "name": "beam",
  "version": "0.1.0",
  "description": "Beam: immersion language learning (German first) with in-context translations from Claude Haiku",
  "scripts": {
    "dev": "convex dev --start \"next dev\"",
    "dev:next": "next dev",
    "dev:convex": "convex dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex",
    "test": "vitest run",
    "e2e:backend": "node --import tsx e2e/backend.ts",
    "e2e:next": "BEAM_E2E=1 BEAM_AI_PROVIDER=mock NEXT_PUBLIC_CONVEX_URL=http://e2e.invalid next dev -p 3000",
    "e2e": "./e2e/run.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/consecrate/beam.git"
  },
  "bugs": {
    "url": "https://github.com/consecrate/beam/issues"
  },
  "homepage": "https://github.com/consecrate/beam#readme",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.283",
    "@anthropic-ai/sdk": "^0.128.0",
    "@mozilla/readability": "^0.6.0",
    "convex": "^1.46.0",
    "linkedom": "^0.18.13",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "convex-test": "^0.0.60",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  }
}
